# Reverse proxy for the droplet: Ravenfall HQ (port 8002, see
# ravenfall/README.md). Caddy fetches and renews a free Let's Encrypt
# certificate for each domain automatically, then proxies HTTPS traffic to
# the site, which listens only on localhost.
#
# This file replaces /etc/caddy/Caddyfile wholesale, so every site the
# droplet serves must have its block here.
#
# Needs A records for ravenfallpmc.com and www.ravenfallpmc.com. Put this
# file at /etc/caddy/Caddyfile, then:
#   sudo systemctl reload caddy

# The apex is the canonical host: the Discord OAuth redirect names
# ravenfallpmc.com, and Discord rejects a callback whose host doesn't match
# exactly -- so www must never serve the site itself, only redirect. It still
# needs its own A record for Caddy to get a certificate for it.
ravenfallpmc.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8002
}

www.ravenfallpmc.com {
    redir https://ravenfallpmc.com{uri} permanent
}
