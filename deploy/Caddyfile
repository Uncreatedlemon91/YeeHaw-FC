# Reverse proxy for every site on the droplet: YeeHaw FC (port 8001, see
# yeehaw/README.md) and Ravenfall HQ (port 8002, see ravenfall/README.md). Caddy fetches and renews
# a free Let's Encrypt certificate for each domain automatically, then
# proxies HTTPS traffic to the sites, which listen only on localhost.
#
# This file replaces /etc/caddy/Caddyfile wholesale, so every site the
# droplet serves must have its block here.
#
# Needs two DNS A records pointing at the droplet: yeehaw-fc.club and
# www.yeehaw-fc.club. Put this file at /etc/caddy/Caddyfile, then:
#   sudo systemctl reload caddy

yeehaw-fc.club {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8001
}

# www -> apex. The apex is the canonical host: NEXTAUTH_URL and the Discord
# OAuth redirect URI both name it, and Discord rejects a callback whose host
# doesn't match the registered redirect exactly -- so www must never serve
# the site itself, only redirect. It still needs its own A record for Caddy
# to get a certificate for it.
www.yeehaw-fc.club {
    redir https://yeehaw-fc.club{uri} permanent
}

# --- Ravenfall HQ ------------------------------------------------------- #
# Needs A records for ravenfallpmc.com and www.ravenfallpmc.com. Until the
# app is running on 8002 this block just answers 502; YeeHaw FC is
# unaffected either way. Same apex-canonical rule as above: the Discord
# OAuth redirect names ravenfallpmc.com.
ravenfallpmc.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8002
}

www.ravenfallpmc.com {
    redir https://ravenfallpmc.com{uri} permanent
}
