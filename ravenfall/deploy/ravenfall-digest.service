[Unit]
Description=Ravenfall HQ weekly digest
After=ravenfall.service

[Service]
Type=oneshot
User=ravenfall
Group=ravenfall
# For NEXTAUTH_SECRET / SITE_PORT, if not already in the file deploy/digest.sh reads.
EnvironmentFile=-/opt/ravenfall/ravenfall/.env
ExecStart=/usr/bin/env bash /opt/ravenfall/ravenfall/deploy/digest.sh
