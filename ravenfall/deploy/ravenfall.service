[Unit]
Description=Ravenfall HQ (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ravenfall
Group=ravenfall
WorkingDirectory=/opt/ravenfall/ravenfall
# The one source of configuration. systemd strips the quotes .env.example
# uses, so the file works unchanged.
EnvironmentFile=/opt/ravenfall/ravenfall/.env
Environment=NODE_ENV=production
# Localhost only; Caddy is the public face. YeeHaw FC has 8001.
Environment=PORT=8002
Environment=HOSTNAME=127.0.0.1
# Keep a runaway from starving YeeHaw FC on a small droplet.
Environment=NODE_OPTIONS=--max-old-space-size=320
MemoryMax=512M
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
