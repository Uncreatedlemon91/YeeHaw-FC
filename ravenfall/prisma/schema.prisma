// Ravenfall HQ data model. Members are keyed by Discord ID: there is no
// local registration, so a User row exists for anyone who has signed in
// with Discord or been acted on by the bot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  CANDIDATE
  ACTIVE
  INACTIVE
  DISCHARGED
}

enum ServiceRecordType {
  ENLISTMENT
  PROMOTION
  AWARD
  QUALIFICATION
  DISCIPLINARY
  TRANSFER
  DISCHARGE
  NOTE
  // Leadership's performance and counselling notes. Seen by the member,
  // their squad leadership and Command.
  COUNSELING
}

enum EventType {
  OP
  TRAINING
  BRIEFING
}

enum AttendanceStatus {
  ATTENDING
  ABSENT
  EXCUSED
  NOSHOW
}

enum QualificationCategory {
  WEAPONS
  LEADERSHIP
  MEDICAL
  PILOT
  GENERAL
}

enum RequestType {
  ROLE
  CALLSIGN
  LOA
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// Who may read a library folder or document: anyone, any operator, squad
// leadership (plus instructors and Command), or Command only.
enum LibraryClearance {
  PUBLIC
  UNIT
  LEADERSHIP
  COMMAND
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
}

model User {
  id              String       @id @default(cuid())
  discordId       String       @unique
  discordUsername String
  avatar          String?
  callsign        String?      @unique
  rank            String?
  // Primary billet; secondaryRoles are what else they're cleared to fill.
  unitRole        String?
  secondaryRoles  String[]     @default([])
  squad           String?
  status          MemberStatus @default(CANDIDATE)
  enlistedAt      DateTime?
  // Start of time-in-grade. Null for members ranked before it existed;
  // the career panel then falls back to their last promotion entry.
  rankSince       DateTime?
  // Self-service: what the member says about themselves.
  bio             String?
  timezone        String?
  availability    String[]     @default([])
  loadout         String?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  serviceRecords       ServiceRecord[]          @relation("RecordSubject")
  issuedRecords        ServiceRecord[]          @relation("RecordIssuer")
  qualifications       UserQualification[]      @relation("QualHolder")
  awardedQuals         UserQualification[]      @relation("QualAwarder")
  attendances          Attendance[]
  applications         RecruitmentApplication[] @relation("Applicant")
  reviewedApplications RecruitmentApplication[] @relation("Reviewer")
  eventsCreated        Event[]                  @relation("EventCreator")
  debriefsWritten      Event[]                  @relation("EventDebriefer")
  documentsEdited      Qualification[]
  requests             PersonnelRequest[]       @relation("Requester")
  reviewedRequests     PersonnelRequest[]       @relation("RequestReviewer")
  libraryDocsCreated   LibraryDocument[]        @relation("LibraryDocCreator")
  libraryDocsUpdated   LibraryDocument[]        @relation("LibraryDocUpdater")
  libraryRevisions     LibraryRevision[]
  libraryAcks          LibraryAcknowledgement[]
  libraryImages        LibraryImage[]
}

model ServiceRecord {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("RecordSubject", fields: [userId], references: [id], onDelete: Cascade)
  type        ServiceRecordType
  title       String
  description String?
  issuedById  String?
  issuedBy    User?             @relation("RecordIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
}

model Event {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  type        EventType
  location    String?
  startTime   DateTime
  endTime     DateTime?
  mandatory   Boolean      @default(false)
  // After-action report, Markdown. Null until a leader files one.
  debrief     String?
  debriefById String?
  debriefBy   User?        @relation("EventDebriefer", fields: [debriefById], references: [id], onDelete: SetNull)
  debriefAt   DateTime?
  createdById String?
  createdBy   User?        @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]

  @@index([startTime])
}

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Before the event this is the member's RSVP (ATTENDING / ABSENT); the
  // AAR overwrites it with what actually happened.
  status    AttendanceStatus
  updatedAt DateTime         @updatedAt

  @@unique([eventId, userId])
}

// A qualification and its manual are one thing: the document is the
// standard a member is certified against.
model Qualification {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  category    QualificationCategory
  summary     String                @default("")
  content     String                @default("")
  version     Int                   @default(1)
  updatedById String?
  updatedBy   User?                 @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  holders     UserQualification[]
  libraryDocs LibraryDocument[]
}

model UserQualification {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation("QualHolder", fields: [userId], references: [id], onDelete: Cascade)
  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  awardedAt       DateTime      @default(now())
  awardedById     String?
  awardedBy       User?         @relation("QualAwarder", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([userId, qualificationId])
}

model RecruitmentApplication {
  id              String            @id @default(cuid())
  discordId       String
  discordUsername String
  userId          String
  user            User              @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  answers         Json
  status          ApplicationStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?             @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote      String?
  // The embed on #recruitment-board, so a decision made on the website
  // can update the Discord post too.
  boardMessageId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([discordId])
}

// Role changes, callsign changes and leaves of absence: asked for by the
// member, decided by their squad leadership or Command (see
// src/lib/personnel.ts for who may decide what).
model PersonnelRequest {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  type           RequestType
  status         RequestStatus @default(PENDING)
  // ROLE: { squad, primary, secondary[] }. CALLSIGN: { callsign }. LOA: {}.
  payload        Json          @default("{}")
  // LOA window, inclusive. Kept as columns so "who is on leave" is a query.
  startDate      DateTime?
  endDate        DateTime?
  reason         String?
  reviewedById   String?
  reviewedBy     User?         @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String?
  decidedAt      DateTime?
  // The post on the personnel board, so either side can update it.
  boardMessageId String?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, status, startDate, endDate])
}

// Site settings an admin edits on the Admin page, one JSON value per key.
// "roles" holds the Discord role mapping (src/lib/role-config.ts).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --- Document library (src/lib/library.ts) -------------------------------- //

// Nested folders. A folder's clearance is never looser than its parent's,
// nor a document's looser than its folder's (enforced in the actions).
model LibraryFolder {
  id        String            @id @default(cuid())
  name      String
  parentId  String?
  parent    LibraryFolder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  LibraryFolder[]   @relation("FolderTree")
  clearance LibraryClearance  @default(UNIT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  documents LibraryDocument[]

  @@index([parentId])
}

model LibraryDocument {
  id        String           @id @default(cuid())
  slug      String           @unique
  title     String
  summary   String           @default("")
  content   String           @default("")
  clearance LibraryClearance @default(UNIT)
  // Null = top level of the library.
  folderId  String?
  folder    LibraryFolder?   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  // Number of the newest LibraryRevision.
  revision  Int              @default(1)

  // Required reading. `required` switches it on; the targets are additive:
  // everyone, or anyone matching a rank (requiredRanks, or at/above
  // requiredMinRank), a billet (requiredRoles) or a squad (requiredSquads).
  // Members acknowledge the current ackVersion; a major edit bumps it so
  // everyone must acknowledge again.
  required         Boolean  @default(false)
  ackVersion       Int      @default(1)
  requiredEveryone Boolean  @default(false)
  requiredMinRank  String?
  requiredRanks    String[] @default([])
  requiredRoles    String[] @default([])
  requiredSquads   String[] @default([])

  createdById String?
  createdBy   User?    @relation("LibraryDocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("LibraryDocUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions        LibraryRevision[]
  acknowledgements LibraryAcknowledgement[]
  images           LibraryImage[]
  // Related vault qualifications.
  qualifications   Qualification[]
  // Full-text search: a GIN expression index on to_tsvector('english',
  // title || ' ' || content) lives in the migration (Prisma can't model it).

  @@index([folderId])
  @@index([clearance, updatedAt])
}

// A snapshot taken on every title/summary/content change, restores included.
model LibraryRevision {
  id         String          @id @default(cuid())
  documentId String
  document   LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number     Int
  title      String
  summary    String          @default("")
  content    String
  note       String?
  // Major edit of a required document (everyone re-acknowledges).
  major      Boolean         @default(false)
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@unique([documentId, number])
}

model LibraryAcknowledgement {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId     String
  document       LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ackVersion     Int
  acknowledgedAt DateTime        @default(now())

  @@unique([userId, documentId, ackVersion])
  @@index([documentId, ackVersion])
}

// An uploaded image file on disk (LIBRARY_UPLOAD_DIR). The file is named
// by id; `filename` is the original name.
model LibraryImage {
  id         String           @id @default(cuid())
  filename   String
  mime       String
  size       Int
  uploaderId String?
  uploader   User?            @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  documentId String?
  document   LibraryDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@index([documentId])
}
