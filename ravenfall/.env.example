# Ravenfall HQ configuration. Copy to .env and fill in.
# On the droplet: /opt/ravenfall/ravenfall/.env, chmod 600.

# --- Database -------------------------------------------------------------- #
DATABASE_URL="postgresql://ravenfall:CHANGE_ME@localhost:5432/ravenfall"

# --- Site ------------------------------------------------------------------ #
# The public URL. NextAuth builds the OAuth callback from it, and the bot uses
# it for every link it posts to Discord.
NEXTAUTH_URL="https://ravenfallpmc.com"
# Signs session cookies. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""
# Times are entered and shown in this zone (IANA name).
UNIT_TIMEZONE="America/New_York"

# --- Discord application (Developer Portal) -------------------------------- #
# OAuth2 page. Register this redirect exactly:
#   https://ravenfallpmc.com/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# General Information -> Public Key. Verifies the interactions endpoint.
DISCORD_PUBLIC_KEY=""
# Bot -> Reset Token. Full bot access: the most sensitive value in this file.
DISCORD_BOT_TOKEN=""
# The unit's server (enable Developer Mode, right-click the server, Copy ID).
DISCORD_GUILD_ID=""

# --- Discord roles -> site permissions ------------------------------------- #
# Comma-separated role IDs. A member gets the highest level any of their roles
# maps to. ADMIN can do everything; RECRUITER and INSTRUCTOR are separate
# grants on top of OPERATOR, so one person can hold both.
ROLE_IDS_ADMIN=""
ROLE_IDS_RECRUITER=""
ROLE_IDS_INSTRUCTOR=""
ROLE_IDS_OPERATOR=""
# Discord user IDs that are always ADMIN whatever their roles. Put your own ID
# here for first setup (the Admin page lists the server's role IDs), then
# clear it once ROLE_IDS_ADMIN is set.
ADMIN_USER_IDS=""

# --- Recruitment pipeline -------------------------------------------------- #
# Removed from, and added to, a candidate when their application is approved.
ROLE_ID_CANDIDATE=""
ROLE_ID_RECRUIT=""
# Where new applications are posted with Approve / Deny buttons.
RECRUITMENT_BOARD_CHANNEL_ID=""
# Where "Post recruitment message" (Admin page) puts the Enlist button.
WELCOME_CHANNEL_ID=""
# Optional: new operations are announced here.
OPS_ANNOUNCE_CHANNEL_ID=""
