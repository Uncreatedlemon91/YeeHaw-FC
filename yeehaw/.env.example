# YeeHaw FC configuration. Copy to .env and fill in.
# On the droplet: /opt/yeehaw/yeehaw/.env, chmod 600.

# --- Database -------------------------------------------------------------- #
DATABASE_URL="postgresql://yeehaw:CHANGE_ME@localhost:5432/yeehaw"

# --- Site ------------------------------------------------------------------ #
# The public URL. NextAuth builds the OAuth callback from it, and the bot uses
# it for every link it posts to Discord.
NEXTAUTH_URL="https://yeehaw-fc.club"
# Signs session cookies. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""
# Times are entered and shown in this zone (IANA name).
CLUB_TIMEZONE="America/New_York"

# Uploaded images (article covers) are stored here (the yeehaw user must own
# it). Defaults to /opt/yeehaw/uploads in production, ./uploads in dev.
# deploy/backup.sh archives it alongside the database dump.
UPLOAD_DIR="/opt/yeehaw/uploads"

# --- Discord application (Developer Portal) -------------------------------- #
# The same application the old site used. OAuth2 page: register this redirect
# exactly (replacing the old site's):
#   https://yeehaw-fc.club/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# General Information -> Public Key. Verifies the interactions endpoint, which
# moves to https://yeehaw-fc.club/api/discord/interactions at cutover.
DISCORD_PUBLIC_KEY=""
# Bot -> Reset Token. Full bot access: the most sensitive value in this file.
DISCORD_BOT_TOKEN=""
# The club's server (enable Developer Mode, right-click the server, Copy ID).
DISCORD_GUILD_ID=""

# --- Discord roles -> site permissions ------------------------------------- #
# Set these on the Admin page (Discord roles & channels) instead. The ROLE_IDS_*
# values below are only read until that mapping is first saved, so a fresh
# deployment works; leave them empty once you use the page.
# Comma-separated role IDs. A person gets the highest level any of their roles
# maps to. MANAGEMENT can do everything; STAFF runs matchday; MEMBER is in the
# club. With no MEMBER role mapped, anyone in the server is a member.
ROLE_IDS_MANAGEMENT=""
ROLE_IDS_STAFF=""
ROLE_IDS_MEMBER=""
# Discord user IDs that are always MANAGEMENT whatever their roles. Put your own
# ID here for first setup, so you can reach the Admin pages and map roles there,
# then clear it once a Management role is saved.
ADMIN_USER_IDS=""

# --- EA Pro Clubs ----------------------------------------------------------- #
# The club's EA identity, for the hourly stats poll. EA issues a brand-new club
# ID every title; set the new one at the start of a game cycle.
EA_CLUB_ID=""
EA_PLATFORM="common-gen5"
EA_CLUB_NAME="Yeehaw FC"
# The league table keeps at most this many clubs (the ones we have played).
EA_LEAGUE_MAX_TEAMS="25"
# Optional. EA's edge blocks plain scripted requests with a 403 (the old site
# used curl_cffi to look like Chrome). If the hourly poll logs 403, install a
# curl-impersonate build and point this at its binary, e.g. /usr/local/bin/curl_chrome124.
EA_CURL_BIN=""
# Where `npm run ea:season` archives the old club's data before erasing it.
BACKUP_DIR="/opt/yeehaw/backups"

# --- AI article (every 48 hours) -------------------------------------------- #
# Token for the Claude Code CLI that writes the roundup. Empty disables it.
CLAUDE_CODE_OAUTH_TOKEN=""
# The CLI binary. Default "claude" on the service's PATH, which includes
# /opt/yeehaw/.local/bin (where the installer puts it for the yeehaw user).
CLAUDE_BIN="claude"
# Optional model override for the roundup.
CLAUDE_MODEL=""
# How often the roundup goes out, and how far back each one looks (days). The
# timer fires daily at 09:15 Eastern and the job skips the days between.
ROUNDUP_DAYS="2"
# The byline on the AI roundup. Dates in it use CLUB_TIMEZONE.
WEEKLY_ARTICLE_AUTHOR="YeeHaw FC Desk"
